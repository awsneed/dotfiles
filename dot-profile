# shellcheck shell=sh
# ~/.profile: executed by the command interpreter for login shells.
# This should stay shell-agnostic, so aim for sh-compatible

echo '~/.profile'

PROFILE_READS=$(( PROFILE_READS + 1 ))
export PROFILE_READS

if [ "$PROFILE_READS" -gt 1 ] && [ -z $CONTAINER_ID ]; then
        echo 'WARNING: .profile has been sourced more than once!'
fi

pathmunge () {
	if ! echo $PATH | /bin/egrep -q "(^|:)$1($|:)" ; then
		if [ "$2" = "after" ] ; then
			PATH=$PATH:$1
		else
			PATH=$1:$PATH
		fi
	fi
}

# User binaries
if [ -d "$HOME/.local/bin" ]; then
	pathmunge "$HOME/.local/bin"
fi

if [ -d "$HOME/bin" ] ; then
	pathmunge "$HOME/bin"
fi

# System local admin install of go
if [ -d "/usr/local/go/bin" ]; then
	pathmunge '/usr/local/go/bin'
fi

# homebrew macOS: man-db
if [ -d "/opt/homebrew/opt/man-db/libexec/bin" ]; then
	pathmunge '/opt/homebrew/opt/man-db/libexec/bin'
fi

# homebrew macOS: coreutils
if [ -d "/opt/homebrew/opt/coreutils/libexec/gnubin" ]; then
	pathmunge "/opt/homebrew/opt/coreutils/libexec/gnubin"
fi

# homebrew macOS: ncurses
if [ -d "/opt/homebrew/opt/ncurses/bin" ]; then
	pathmunge "/opt/homebrew/opt/ncurses/bin"
fi

# Add .NET Core SDK tools
if [ -d "$HOME/.dotnet/tools" ]; then
	pathmunge "$HOME/.dotnet/tools"
fi

# homebrew macOS: llvm
if [ -d "/opt/homebrew/opt/llvm/bin" ]; then
	pathmunge "/opt/homebrew/opt/llvm/bin"
fi

# MacPorts
if [ -d "/opt/local/bin" ]; then
	pathmunge "/opt/local/bin"
fi
if [ -d "/opt/local/sbin" ]; then
	pathmunge "/opt/local/sbin"
fi

# Flatpak
flatpak_exports_system="/var/lib/flatpak/exports/bin"
flatpak_exports_user="$HOME/.local/share/flatpak/exports/bin"
if [ -d "$flatpak_exports_system" ]; then
	FLATPAK_EXPORTS_DIRS="$flatpak_exports_system"
fi
if [ -d "$flatpak_exports_user" ]; then
	[ -n "$FLATPAK_EXPORTS_DIRS" ] && FLATPAK_EXPORTS_DIRS=:"$FLATPAK_EXPORTS_DIRS"
	FLATPAK_EXPORTS_DIRS="$flatpak_exports_user""$FLATPAK_EXPORTS_DIRS"
fi
if [ -n "$FLATPAK_EXPORTS_DIRS" ]; then
	pathmunge "$FLATPAK_EXPORTS_DIRS"
fi
export FLATPAK_EXPORTS_DIRS
unset flatpak_exports_system
unset flatpak_exports_user

# homebrew macOS
if [ -x "/opt/homebrew/bin/brew" ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# rust
if [ -r "$HOME/.cargo/env" ]; then
        . "$HOME/.cargo/env"
fi

# lesspipe
if command -v lesspipe >/dev/null; then
        eval "$(lesspipe)"
fi

# homebrew macOS: lesspipe
if [ -f "/opt/homebrew/bin/lesspipe.sh" ]; then
        LESSOPEN="|/opt/homebrew/bin/lesspipe.sh %s"; export LESSOPEN
fi

# homebrew macOS: ncurses terminfo
if [ -d "/opt/homebrew/opt/ncurses/share/terminfo" ]; then
        TERMINFO_DIRS="/opt/homebrew/opt/ncurses/share/terminfo"; export TERMINFO_DIRS
fi

# colored GCC warnings and errors
GCC_COLORS='error=01;31:warning=01;35:note=01;36:caret=01;32:locus=01:quote=01'; export GCC_COLORS

# Default visual and editor to vim / vi
if command -v vim >/dev/null; then
        VISUAL='vim'
        EDITOR='vim -E'
else
        # Assume vi is everywhere. God help me if it's not
        VISUAL='vi'
        EDITOR='vi -E'
fi
export VISUAL EDITOR

# Locale / timezone
TZ='America/Chicago'; export TZ

# less starts in "secure mode"
LESSSECURE=1; export LESSSECURE

# GnuPG + SSH Agent
gpg-connect-agent /bye >/dev/null
unset -v SSH_AGENT_PID
# Don't set this on SSH logins, because ssh agent forwarding may need to
if [ "${gnupg_SSH_AUTH_SOCK_by:-0}" -ne $$ ] && [ -z "$SSH_CONNECTION" ]; then
        SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)"
        export SSH_AUTH_SOCK
fi

# Xresources
Xresources="$HOME/.Xresources"
if [ -f "$Xresources" ] && [ -n "$DISPLAY" ] && command -v xrdb >/dev/null; then
	xrdb -merge "$Xresources"
fi
unset Xresources

## Host-specific config handling
# Leave this at the end
[ -f "$HOME/.profile.local" ] && . "$HOME/.profile.local"

