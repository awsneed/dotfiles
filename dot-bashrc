# shellcheck shell=bash
# ~/.bashrc: executed by bash(1) for non-login shells.

(( BASHRC_READS++ ))
export BASHRC_READS

## MISC (primarily from Debian) ##
# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# set variable identifying the chroot you work in (used in the prompt below)
if [[ -z "${debian_chroot:-}" ]] && [[ -r /etc/debian_chroot ]]; then
    debian_chroot=$(cat /etc/debian_chroot)
fi

# Determine color support
if type -t tput >/dev/null && [[ $(tput colors) -ge 8 ]]; then
        color_prompt='yes'
fi

if [[ "$color_prompt" = 'yes' ]]; then
        # Original
        #PS1='${debian_chroot:+($debian_chroot)}\[\033[01;32m\]\u@\h\[\033[00m\] \[\033[01;34m\]\w\[\033[00m\]\$ '

        PS1=

        # Add container ID if in container
        if [[ -n "$CONTAINER_ID" ]]; then
                PS1+="\[\033[01;32m\]${CONTAINER_ID}📦\[\033[00m\]"
        fi

        PS1+="${debian_chroot:+($debian_chroot)}"

        # Show user@hostname if not in tmux
        if [[ -z "$TMUX" ]]; then
                PS1+='\[\033[01;32m\]\u@\h\[\033[00m\] '
        fi

        # Common prompt
        PS1+='\[\033[01;34m\]\w\[\033[00m\]\$ '
else
        # Original
        #PS1='${debian_chroot:+($debian_chroot)}\u@\h \w\$ '

        PS1=

        # Add container ID if in container
        if [[ -n $CONTAINER_ID ]]; then
                PS1+="${CONTAINER_ID}📦"
        fi

        PS1+="${debian_chroot:+($debian_chroot)}"

        # Show user@hostname if not in tmux
        if [[ -z $TMUX ]]; then
                PS1+='\u@\h '
        fi

        # Common prompt
        PS1+='\w\$ '
fi
unset color_prompt force_color_prompt

# If this is an xterm set the title to PWD
case "$TERM" in
xterm*|rxvt*|tmux*|screen*|ghostty*)
    #PS1="\[\e]0;${debian_chroot:+($debian_chroot)}\u@\h  \w\a\]$PS1"

    PS1="\[\e]0;${debian_chroot:+($debian_chroot) }\w\$ - \s\a\]$PS1"
    ;;
*)
    ;;
esac

# enable programmable completion features (you don't need to enable
# this, if it's already enabled in /etc/bash.bashrc and /etc/profile
# sources /etc/bash.bashrc).
if ! shopt -oq posix; then
        if [[ -f /usr/share/bash-completion/bash_completion ]]; then
                . /usr/share/bash-completion/bash_completion
        elif [[ -f /etc/bash_completion ]]; then
                . /etc/bash_completion
        fi
fi

## SENSIBLE.BASH ##
## GENERAL OPTIONS ##

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# Automatically trim long paths in the prompt (requires Bash 4.x)
PROMPT_DIRTRIM=2

# Enable history expansion with space
# E.g. typing !!<space> will replace the !! with your last command
bind Space:magic-space

# If set, the pattern "**" used in a pathname expansion context will
# match all files and zero or more directories and subdirectories.
#shopt -s globstar

## SMARTER TAB-COMPLETION (Readline bindings) ##

# Display matches for ambiguous patterns at first tab press
bind "set show-all-if-ambiguous on"

## SANE HISTORY DEFAULTS ##

# Append to the history file, don't overwrite it
shopt -s histappend

# Save multi-line commands as one command
shopt -s cmdhist

# Record each line as it gets issued
PROMPT_COMMAND='history -a'

# for setting history length see HISTSIZE and HISTFILESIZE in bash(1)
#HISTSIZE=1000
#HISTFILESIZE=2000
# sensible.bash
# Huge history. Doesn't appear to slow things down, so why not?
HISTSIZE=500000
HISTFILESIZE=100000

# don't put duplicate lines or lines starting with space in the history.
# See bash(1) for more options
#HISTCONTROL=ignoreboth
# Avoid duplicate entries
HISTCONTROL="erasedups:ignoreboth"

# Don't record some commands
export HISTIGNORE="&:[ ]*:exit:ls:bg:fg:history:clear"

# Use standard ISO 8601 timestamp
# %F equivalent to %Y-%m-%d
# %T equivalent to %H:%M:%S (24-hours format)
HISTTIMEFORMAT='%F %T '

# Enable incremental history search with up/down arrows (also Readline goodness)
# Learn more about this here: http://codeinthehole.com/writing/the-most-important-command-line-tip-incremental-history-searching-with-inputrc/
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'
bind '"\e[C": forward-char'
bind '"\e[D": backward-char'

# homebrew macOS: bash-completion@3
if [[ -r "/opt/homebrew/etc/profile.d/bash_completion.sh" ]]; then 
        . "/opt/homebrew/etc/profile.d/bash_completion.sh"
fi

# ssh and gpg-agent
GPG_TTY=$(tty)
export GPG_TTY
gpg-connect-agent updatestartuptty /bye >/dev/null

## Aliases
# Color support aliases
alias ls='ls --color=auto'
alias dir='dir --color=auto'
alias vdir='vdir --color=auto'
alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'
alias ip='ip -c'
alias less='less -R'

type -t pacman >/dev/null && alias pacman='pacman --color=auto'

# Update active tty for ssh per-invocation
alias ssh='export GPG_TTY=$(tty) && gpg-connect-agent updatestartuptty /bye >/dev/null && ssh'

# Auto reflinks where possible with cp
alias cp='cp --reflink=auto'

alias ssh-keygen-mozilla='ssh-keygen -t ed25519'
alias ssh-keygen-mozilla-legacy='ssh-keygen -t rsa -b 4096'

# WSL Yubikey convenience
if type -t usbipd.exe >/dev/null; then
        alias attach-yubikey='usbipd.exe attach --wsl -i 1050:0407'
        alias detach-yubikey='usbipd.exe detach -i 1050:0407'
fi

# Nice-r-ish view(s) of authpriv
alias view-authpriv='sudo SYSTEMD_LESS=FRXMK journalctl -xe --follow --no-hostname SYSLOG_FACILITY=10'
alias view-authpriv-no_ssh_exporter="view-authpriv |  grep -i -v -e 'session opened for user ssh_exporter by (uid=0)' -e 'session closed for user ssh_exporter'"
alias view-authpriv-access_denied="view-authpriv |  grep -i -e 'Access denied'"
alias view-authpriv-sudo_attempts="view-authpriv |  grep -i -e 'sudo:session' -e 'user NOT in sudoers' -e 'COMMAND='"

# SSSD logs convenience
alias view-sssd-logs="sudo bash -c 'tail -n +0 -F /var/log/sssd/*.log'"
alias view-most-logs="sudo bash -c 'tail -n +0 -F /var/log/*.log'"

# gp-saml-gui to connect to campus VPN
alias uarkvpn="gp-saml-gui --allow-insecure-crypto -S go.secure.uark.edu"

# Host-specific config handling
[[ -f "$HOME/.bashrc.local" ]] && . "$HOME/.bashrc.local"

# Auto create a new session in a tmux session group
if type -t tmux >/dev/null && [[ -z "$TMUX" ]]; then
        TMUX_SESSION_GROUP='0'

        # Custom groups for weird terminal hosts
        case $TERM_PROGRAM in
                vscode) TMUX_SESSION_GROUP="$TERM_PROGRAM" ;;
        esac

        printf 'Launching tmux session in group %s... ' "$TMUX_SESSION_GROUP"
        tmux new-session -t "$TMUX_SESSION_GROUP"
fi
